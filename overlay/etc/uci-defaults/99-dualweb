#!/bin/sh
# First-boot setup: preserve router LAN defaults and move LuCI to 8080.
uci -q delete uhttpd.main.listen_http
uci add_list uhttpd.main.listen_http='0.0.0.0:8080'
uci add_list uhttpd.main.listen_http='[::]:8080'
uci commit uhttpd

/etc/init.d/uhttpd enable
/etc/init.d/dualweb-api enable
/etc/init.d/nginx enable

mkdir -p /etc/dualweb /etc/dualweb/profiles /root
# Initialize the homepage password once. Do not reset it on later boots.
if [ ! -s /etc/dualweb/password ]; then
    printf '%s' 'root' > /etc/dualweb/password
    chmod 600 /etc/dualweb/password
    printf '首页初始密码：root\n请登录后立即修改。\n' > /root/dualweb-initial-password.txt
    chmod 600 /root/dualweb-initial-password.txt
fi
if [ ! -s /etc/dualweb/session-key ]; then
    head -c 32 /dev/urandom | hexdump -v -e '/1 "%02x"' > /etc/dualweb/session-key
    chmod 600 /etc/dualweb/session-key
fi
if [ ! -s /etc/dualweb/mihomo-secret ]; then
    head -c 32 /dev/urandom | hexdump -v -e '/1 "%02x"' > /etc/dualweb/mihomo-secret
    chmod 600 /etc/dualweb/mihomo-secret
fi

# Install Vantage and Nikki after WAN connectivity is available.
(
  LOG=/tmp/dualweb-firstboot.log
  echo "$(date): firstboot package install started" >> "$LOG"
  n=0
  while [ "$n" -lt 60 ]; do
    if wget -q -T 5 -O /dev/null https://downloads.immortalwrt.org/; then break; fi
    n=$((n+1)); sleep 10
  done
  if [ "$n" -ge 60 ]; then echo "No internet; install packages manually later" >> "$LOG"; exit 0; fi

  mkdir -p /etc/apk/repositories.d /etc/apk/keys
  if wget -q -T 20 -O /etc/apk/keys/vantage-signing.pem https://anothadev.github.io/luci-theme-vantage/vantage-signing.pem; then
    SUM="$(sha256sum /etc/apk/keys/vantage-signing.pem | awk '{print $1}')"
    if [ "$SUM" = "c8a6c83eeb49ca2407932fb5e95785776128cef87db75ebaea0fe4171eee2157" ]; then
      grep -q 'anothadev.github.io/luci-theme-vantage/25.12/packages.adb' /etc/apk/repositories.d/customfeeds.list 2>/dev/null || echo 'https://anothadev.github.io/luci-theme-vantage/25.12/packages.adb' >> /etc/apk/repositories.d/customfeeds.list
      apk update >> "$LOG" 2>&1 && apk add luci-theme-vantage luci-app-vantage >> "$LOG" 2>&1
      if [ $? -eq 0 ]; then
        uci -q set luci.main.mediaurlbase='/luci-static/vantage'
        uci -q commit luci
        echo "Vantage installed" >> "$LOG"
      else echo "Vantage package install failed; see log" >> "$LOG"; fi
    else echo "Vantage key checksum mismatch; refusing install" >> "$LOG"; rm -f /etc/apk/keys/vantage-signing.pem; fi
  else echo "Could not download Vantage key" >> "$LOG"; fi

  if wget -q -T 30 -O /tmp/dualweb-nikki-install.sh https://github.com/nikkinikki-org/OpenWrt-nikki/raw/refs/heads/main/install.sh && [ -s /tmp/dualweb-nikki-install.sh ]; then
    if ash /tmp/dualweb-nikki-install.sh >> "$LOG" 2>&1; then
      echo "Nikki installer succeeded" >> "$LOG"
    else
      echo "Nikki installer failed; see log and retry manually" >> "$LOG"
    fi
  else
    echo "Could not download Nikki installer; install via LuCI/SSH" >> "$LOG"
  fi
  /etc/init.d/nginx restart
  /etc/init.d/uhttpd restart
  echo "$(date): firstboot package install finished" >> "$LOG"
) >/dev/null 2>&1 &

exit 0
